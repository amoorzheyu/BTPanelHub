{
  "name": "btpanelhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.worker.config.ts",
    "test": "vitest run",
    "package": "npm run build && node scripts/package.mjs",
    "version": "node scripts/sync-version.mjs && git add public/manifest.json",
    "release:check": "node scripts/check-release.mjs",
    "test:release": "node --test scripts/release-version.check.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.67.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.3.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=24"
  }
}
